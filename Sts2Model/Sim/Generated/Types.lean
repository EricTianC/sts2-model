import Sts2Model.Sim.EffectIR

namespace Sts2Model.Sim.Generated

open Sts2Model.Core
open Sts2Model.Model
open Sts2Model.Combat
open Sts2Model.Sim

/-- Helper constructor for generated canonical PowerInstance templates. -/
@[inline] def mkGenPower (entry : String) (pType : PowerType) (sType : PowerStackType)
    (iType : PowerInstanceType) (allowNeg : Bool) : PowerInstance :=
  { instanceId := 0, modelId := ModelId.mkPower entry, ownerId := 0
  , powerType := pType, stackType := sType, instanceType := iType
  , allowNegative := allowNeg, amount := 1 }

structure GeneratedCardEntry where
  id          : String
  baseOps     : EffectProgram
  upgradedOps : EffectProgram
  deriving Repr, DecidableEq

structure GeneratedPotionEntry where
  id  : String
  ops : EffectProgram
  deriving Repr, DecidableEq

structure GeneratedMonsterNode where
  id              : String
  followUpId      : String := ""
  isRandomBranch  : Bool := false
  randomTargets   : List (String × Nat) := []
  mustPerformOnce : Bool := false
  deriving Repr, DecidableEq

structure GeneratedMonsterMove where
  moveId : String
  ops    : EffectProgram
  deriving Repr, DecidableEq

structure GeneratedMonsterEntry where
  id             : String
  initialStateId : String
  nodes          : List GeneratedMonsterNode
  moves          : List GeneratedMonsterMove
  deriving Repr, DecidableEq

def toMonsterBlueprint (m : GeneratedMonsterEntry) : MonsterBlueprint :=
  { modelId := ModelId.mkMonster m.id
  , stateMachine :=
      { initialStateId := m.initialStateId
      , currentStateId := m.initialStateId
      , nodes := fun sid =>
          match m.nodes.find? (·.id == sid) with
          | none => none
          | some n =>
              let kind : MonsterStateKind :=
                if n.isRandomBranch then .randomBranch n.randomTargets
                else .move n.followUpId true n.mustPerformOnce
              some { id := n.id, kind := kind, shouldAppearInLogs := !n.isRandomBranch } }
  , moveEffects := fun mid =>
      match m.moves.find? (·.moveId == mid) with
      | some mv => mv.ops
      | none => [] }

/-- Decidable structural well-formedness check for generated card entries. -/
def cardEntryWellFormed (c : GeneratedCardEntry) : Bool :=
  !c.id.isEmpty && (!c.baseOps.isEmpty || !c.upgradedOps.isEmpty)

/-- Decidable structural well-formedness check for generated potion entries. -/
def potionEntryWellFormed (p : GeneratedPotionEntry) : Bool :=
  !p.id.isEmpty && !p.ops.isEmpty

/-- Decidable structural well-formedness check for generated monster blueprints. -/
def monsterEntryWellFormed (m : GeneratedMonsterEntry) : Bool :=
  let hasNode (sid : String) : Bool := m.nodes.any (·.id == sid)
  let hasMove (mid : String) : Bool := m.moves.any (·.moveId == mid)
  !m.id.isEmpty && !m.initialStateId.isEmpty && hasNode m.initialStateId &&
  m.nodes.all fun n =>
    if n.isRandomBranch then
      !n.randomTargets.isEmpty && n.randomTargets.all (fun (tid, w) => hasNode tid && w > 0)
    else
      hasMove n.id && (n.followUpId.isEmpty || hasNode n.followUpId)

