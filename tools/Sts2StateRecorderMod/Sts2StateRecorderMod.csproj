<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Sts2StateRecorder</AssemblyName>
    <RootNamespace>Sts2StateRecorder</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(STS2_DATA_DIR)' != ''">$(STS2_DATA_DIR)</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(Sts2DataDir)' != '' and Exists('$(Sts2DataDir)/sts2.dll') and Exists('$(Sts2DataDir)/0Harmony.dll')">
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)/sts2.dll') or !Exists('$(Sts2DataDir)/0Harmony.dll')">
    <ProjectReference Include="Stubs/Sts2Stub/Sts2Stub.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="Stubs/HarmonyStub/HarmonyStub.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Stubs/**/*.cs" />
    <None Include="mod_manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
